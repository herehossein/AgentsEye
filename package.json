{
  "name": "agentseye",
  "version": "2.2.1",
  "description": "Zero-dependency browser runtime inspector CLI and skill for autonomous AI agents and developers",
  "type": "module",
  "bin": {
    "agentseye": "agentsEye.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "npm run build && node --test dev/tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  },
  "license": "MIT",
  "author": "herehossein",
  "repository": {
    "type": "git",
    "url": "https://github.com/herehossein/agentsEye.git"
  },
  "bugs": {
    "url": "https://github.com/herehossein/agentsEye/issues"
  },
  "homepage": "https://github.com/herehossein/agentsEye",
  "files": [
    "agentsEye.mjs",
    "SKILL.md",
    "references/",
    "README.md",
    "README.fa.md",
    "LICENSE"
  ],
  "keywords": [
    "agent",
    "cdp",
    "devtools",
    "layout",
    "overflow",
    "inspector",
    "ai-agent",
    "skills"
  ]
}
